cabal-version:      3.0
name:               frontier-laws
version:            0.1.0.0
synopsis:           Frontier AI laws as pure Haskell (compute / AI layer)
license:            MIT
author:             Wade Kariniemi
maintainer:         Wadek@users.noreply.github.com
build-type:         Simple
category:           Logic

library
  exposed-modules:
      Frontier.Role
      Frontier.Gate
      Frontier.Laws
      Frontier.OWASP
      Frontier.Hygiene
  hs-source-dirs:   src
  build-depends:    base >= 4.14 && < 5
  default-language: Haskell2010
  ghc-options:      -Wall

test-suite frontier-laws-test
  type:             exitcode-stdio-1.0
  main-is:          Spec.hs
  hs-source-dirs:   test
  build-depends:    base, frontier-laws
  default-language: Haskell2010
